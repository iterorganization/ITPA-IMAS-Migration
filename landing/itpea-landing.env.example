## Environment file for itpea-landing.service (/etc/itpea-landing/itpea-landing.env).
## Values shown are the defaults.

## Host port of the plain-HTTP listener.
#LANDING_PORT=8081

## HTTPS listener, for an F5 that forwards to the backend on 443/TCP.
## Enable by adding the https overlay; needs server.crt/server.key in LANDING_TLS_DIR
## (`sudo make tls-selfsigned` creates a self-signed pair).
#COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
#LANDING_HTTPS_PORT=443
#LANDING_TLS_DIR=/etc/itpea-landing/tls

## SimDB dashboard, as published on this host (DASHBOARD_PORT in simdb-dashboard.env).
#DASHBOARD_HOST=host.docker.internal
#DASHBOARD_PORT=80

## SimDB server, as published on this host.
#SIMDB_HOST=host.docker.internal
#SIMDB_PORT=5000
