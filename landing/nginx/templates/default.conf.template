# Front door for itpea-db.iter.org.
#
#   /                 static landing page (landing/site)
#   /dashboard/       proxied to the SimDB dashboard container
#   /scenarios/api/   proxied straight to the SimDB server (same rules as the
#                     dashboard's own nginx, see SimDB-Dashboard
#                     docker/nginx/templates/snippets/location-simdb_proxy.conf.template)
#
# The official nginx image runs envsubst on /etc/nginx/templates/*.template at
# startup, substituting only variables that are set in the container
# environment (DASHBOARD_HOST/PORT, SIMDB_HOST/PORT), so nginx's own $variables
# below are left alone.

upstream dashboard_backend {
    server ${DASHBOARD_HOST}:${DASHBOARD_PORT};
}

upstream simdb_backend {
    server ${SIMDB_HOST}:${SIMDB_PORT};
}

# Behind the F5, TLS ends at the F5 and requests arrive over plain HTTP.
# Keep the F5's X-Forwarded-Proto so the backends build https:// URLs.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location = /dashboard {
        return 301 /dashboard/;
    }

    location /dashboard/ {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_pass http://dashboard_backend;
    }

    # Same prefixes the dashboard's nginx accepts. The prefix is stripped and
    # SimDB is told about it through X-Forwarded-Prefix.
    location ~ "^/(?:scenarios/api|scenarios|api|swaggerui)" {
        rewrite ^/(?:scenarios/api|scenarios|api)?/?(.*) /$1 break;

        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Prefix /scenarios/api;

        # SimDB file uploads (idsmigration --remote) send bodies above the 1M default.
        client_max_body_size 10M;
        client_body_buffer_size 10M;

        proxy_pass http://simdb_backend;
    }
}
